# Godot 4 generated cache (imported textures, shader cache, editor state)
.godot/

# Godot mono build output
.mono/
data_*/
mono_crash.*.json

# Export output (export_presets.cfg stays tracked so everyone exports the same way)
build/
export/
export_credentials.cfg
*.apk
*.aab
*.exe
*.pck
*.dmg

# Translations compiled from .po/.csv
*.translation

# Editor, OS and tooling files
.vs/
*.tmp
*.swp
.DS_Store
Thumbs.db
Desktop.ini
node_modules/
.venv/

# Local preview task contains machine-specific executable and scratch paths.
/.vscode/tasks.json

# Local character-sheet draft (other documentation remains trackable).
/docs/CHARACTER_SHEETS.md

# Keep *.import and *.uid files tracked: they hold import settings and stable resource UIDs.
# Only the .godot/ cache is regenerated.
