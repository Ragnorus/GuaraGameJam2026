server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    types {
        include /etc/nginx/mime.types;
        application/wasm wasm;
    }

    gzip on;
    gzip_types application/wasm application/javascript text/css application/octet-stream;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
